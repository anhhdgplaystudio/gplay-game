{
  "description": "Guard GPlay: chặn sửa YAML Unity / .meta / bí mật; chỉ bật ở dự án có .claude/guard.json enabled",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
